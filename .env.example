# SafeSignal Environment Variables Example
# Server-side Gemini API key (never expose to client)
GEMINI_API_KEY=your-api-key

# Gemini model identifier (e.g., gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Set to true if using a paid Gemini API tier (free tier warns user about privacy terms)
GEMINI_PAID_TIER=false

# Gemini request timeout in seconds
GEMINI_TIMEOUT_SECONDS=30

# Maximum character lengths for user inputs
MAX_DESCRIPTION_CHARS=4000
MAX_EVIDENCE_CHARS=20000

# Rate limits (in-memory per-instance sliding window)
RATE_LIMIT_PER_MINUTE=6
DAILY_ANALYSIS_CAP=300

# Trust X-Forwarded-For header when behind a reverse proxy (set true only behind a trusted reverse proxy)
TRUST_PROXY=false

# Application environment: development | production
APP_ENV=development
